# Copy this file to .env and fill in. Never commit .env.
OPENAI_API_KEY=
# Optional second provider (OpenAI-compatible endpoint, e.g. OpenRouter)
ALT_API_KEY=
ALT_BASE_URL=https://openrouter.ai/api/v1
# Model that writes the outlet articles
WRITER_MODEL=gpt-5.4-mini
# Agent models under test, comma separated. Prefix alt: to use the second provider.
AGENT_MODELS=gpt-5.4-mini
